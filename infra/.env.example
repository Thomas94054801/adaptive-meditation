# Copy to infra/.env and fill in. Never commit the filled-in file.
# infra/.env is excluded by .gitignore.

# Required: PostgreSQL password for the adaptive role.
POSTGRES_PASSWORD=change-me

# Public hostname in production, for example meditation.example.com.
# Leave as :80 for a local run; Caddy provisions TLS for a real hostname.
SITE_ADDRESS=:80

APP_ENV=production

# Optional. Program001 requires no AI or TTS credential: leaving these at null
# keeps the deterministic engine, which is the only recommendation path.
AI_PROVIDER=null
TTS_PROVIDER=null
# AI_API_KEY=
