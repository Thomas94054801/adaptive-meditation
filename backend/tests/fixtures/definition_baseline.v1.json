    "breath_awareness": {
      "canonical_json": "{\"locale\":\"en-US\",\"practice_id\":\"breath_awareness\",\"protocol_id\":\"breath_awareness_v2\",\"public_title\":\"Breath Awareness\",\"schema_version\":1,\"source\":\"authored\",\"stages\":[{\"intent\":\"establish_posture\",\"min_silence_seconds\":5,\"prompt_template\":\"Settle into a position you can hold for ${duration_minutes} minutes. Let your shoulders drop and your hands rest.\",\"silence_after_seconds\":5,\"stage_id\":\"arrive\"},{\"intent\":\"notice_natural_breath\",\"min_silence_seconds\":6,\"prompt_template\":\"Find where the breath is easiest to feel - the nose, the chest or the belly. Stay with that one place. Let the breath move at its own pace.\",\"silence_after_seconds\":15,\"stage_id\":\"contact\"},{\"intent\":\"return_without_force\",\"min_silence_seconds\":12,\"prompt_template\":\"When attention wanders, notice where it went and come back to the same place. Coming back is the practice, not a mistake.\",\"silence_after_seconds\":30,\"stage_id\":\"stabilize\"},{\"intent\":\"transition_out\",\"min_silence_seconds\":5,\"prompt_template\":\"Widen your attention to the whole body and the sounds around you. Take one slower breath before you open your eyes.\",\"silence_after_seconds\":10,\"stage_id\":\"close\"}],\"version\":2}",
