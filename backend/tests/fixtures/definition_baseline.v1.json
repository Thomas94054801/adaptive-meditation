    "thought_observation": {
      "canonical_json": "{\"locale\":\"en-US\",\"practice_id\":\"thought_observation\",\"protocol_id\":\"thought_observation_v2\",\"public_title\":\"Thought Observation\",\"schema_version\":1,\"source\":\"authored\",\"stages\":[{\"intent\":\"establish_posture\",\"min_silence_seconds\":5,\"prompt_template\":\"Settle for ${duration_minutes} minutes. Let the body be still and let the breath find its own rhythm.\",\"silence_after_seconds\":5,\"stage_id\":\"arrive\"},{\"intent\":\"see_thought_as_event\",\"min_silence_seconds\":8,\"prompt_template\":\"Watch for the next thought to arrive. See it as an event that appears and passes, the way a sound appears and passes.\",\"silence_after_seconds\":20,\"stage_id\":\"notice_thinking\"},{\"intent\":\"reduce_identification\",\"min_silence_seconds\":10,\"prompt_template\":\"You do not have to follow the thought or push it away. Let it be there and let it go on its own. Come back to the breath between them.\",\"silence_after_seconds\":25,\"stage_id\":\"release\"},{\"intent\":\"transition_out\",\"min_silence_seconds\":5,\"prompt_template\":\"Let the watching relax. Feel the body and the room again before you finish.\",\"silence_after_seconds\":10,\"stage_id\":\"close\"}],\"version\":2}",
