    "open_awareness": {
      "canonical_json": "{\"locale\":\"en-US\",\"practice_id\":\"open_awareness\",\"protocol_id\":\"open_awareness_v2\",\"public_title\":\"Open Awareness\",\"schema_version\":1,\"source\":\"authored\",\"stages\":[{\"intent\":\"establish_posture\",\"min_silence_seconds\":5,\"prompt_template\":\"Sit upright for ${duration_minutes} minutes. Let the eyes be soft, open or closed.\",\"silence_after_seconds\":5,\"stage_id\":\"arrive\"},{\"intent\":\"include_whole_field\",\"min_silence_seconds\":10,\"prompt_template\":\"Instead of choosing one object, let attention stay wide. Sounds, sensations and thoughts can come and go without being followed.\",\"silence_after_seconds\":25,\"stage_id\":\"open_field\"},{\"intent\":\"rest_without_grasping\",\"min_silence_seconds\":14,\"prompt_template\":\"Notice how experience changes by itself. Let it. Nothing here needs to be held on to or removed.\",\"silence_after_seconds\":35,\"stage_id\":\"rest_open\"},{\"intent\":\"transition_out\",\"min_silence_seconds\":5,\"prompt_template\":\"Narrow gently back to the breath and the body for the last few moments, then finish.\",\"silence_after_seconds\":10,\"stage_id\":\"close\"}],\"version\":2}",
