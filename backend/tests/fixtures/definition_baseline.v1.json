    "kindness": {
      "canonical_json": "{\"locale\":\"en-US\",\"practice_id\":\"kindness\",\"protocol_id\":\"kindness_v2\",\"public_title\":\"Kindness Practice\",\"schema_version\":1,\"source\":\"authored\",\"stages\":[{\"intent\":\"establish_posture\",\"min_silence_seconds\":5,\"prompt_template\":\"Take ${duration_minutes} minutes. Let the face and shoulders soften and rest a hand somewhere comfortable if you like.\",\"silence_after_seconds\":5,\"stage_id\":\"arrive\"},{\"intent\":\"offer_goodwill_to_self\",\"min_silence_seconds\":6,\"prompt_template\":\"Offer yourself a simple line, in your own words: may I be at ease. Say it slowly and notice how it lands, even if nothing shifts.\",\"silence_after_seconds\":15,\"stage_id\":\"toward_self\"},{\"intent\":\"offer_goodwill_to_another\",\"min_silence_seconds\":8,\"prompt_template\":\"Bring to mind someone straightforward to care about, and offer them the same line. Keep it simple and unhurried.\",\"silence_after_seconds\":20,\"stage_id\":\"toward_another\"},{\"intent\":\"extend_goodwill\",\"min_silence_seconds\":6,\"prompt_template\":\"Let the wish widen to people you do not know well - anyone nearby, anyone having a hard day.\",\"silence_after_seconds\":15,\"stage_id\":\"widen\"},{\"intent\":\"transition_out\",\"min_silence_seconds\":5,\"prompt_template\":\"Let the words stop and stay with whatever warmth is left, however small, then finish.\",\"silence_after_seconds\":10,\"stage_id\":\"close\"}],\"version\":2}",
