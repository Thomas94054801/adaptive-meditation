    "body_awareness": {
      "canonical_json": "{\"locale\":\"en-US\",\"practice_id\":\"body_awareness\",\"protocol_id\":\"body_awareness_v2\",\"public_title\":\"Body Awareness\",\"schema_version\":1,\"source\":\"authored\",\"stages\":[{\"intent\":\"establish_contact\",\"min_silence_seconds\":5,\"prompt_template\":\"For the next ${duration_minutes} minutes, let attention come down out of the head. Feel the points where your body meets the floor or chair.\",\"silence_after_seconds\":5,\"stage_id\":\"arrive\"},{\"intent\":\"release_obvious_holding\",\"min_silence_seconds\":5,\"prompt_template\":\"Scan the jaw, the shoulders and the hands. Where you find holding, let it soften by as much as it wants to.\",\"silence_after_seconds\":10,\"stage_id\":\"settle\"},{\"intent\":\"move_attention_through_body\",\"min_silence_seconds\":10,\"prompt_template\":\"Move attention slowly from the feet upward. Feel each area directly - warmth, weight, pressure, movement - rather than picturing it.\",\"silence_after_seconds\":25,\"stage_id\":\"sweep\"},{\"intent\":\"whole_body_sense\",\"min_silence_seconds\":8,\"prompt_template\":\"Let the whole body be felt at once, as one sensation. Nothing to fix and nowhere to get to.\",\"silence_after_seconds\":20,\"stage_id\":\"rest\"},{\"intent\":\"transition_out\",\"min_silence_seconds\":5,\"prompt_template\":\"Notice how the body feels now compared with when you started. Move your fingers before you finish.\",\"silence_after_seconds\":10,\"stage_id\":\"close\"}],\"version\":2}",
