    "mindful_walking": {
      "canonical_json": "{\"locale\":\"en-US\",\"practice_id\":\"mindful_walking\",\"protocol_id\":\"mindful_walking_v2\",\"public_title\":\"Mindful Walk\",\"schema_version\":1,\"source\":\"authored\",\"stages\":[{\"intent\":\"establish_standing_posture\",\"min_silence_seconds\":5,\"prompt_template\":\"Stand for a moment before you set off. Feel your feet on the ground and let your arms hang. You have ${duration_minutes} minutes.\",\"silence_after_seconds\":5,\"stage_id\":\"arrive\"},{\"intent\":\"find_a_slower_pace\",\"min_silence_seconds\":5,\"prompt_template\":\"Walk a little slower than usual, wherever you are. Let the pace be even. There is nowhere you need to arrive.\",\"silence_after_seconds\":10,\"stage_id\":\"set_pace\"},{\"intent\":\"feel_each_step\",\"min_silence_seconds\":10,\"prompt_template\":\"Feel each step land - the heel, then the whole foot, then the lift. When attention drifts, the next step is already there to come back to.\",\"silence_after_seconds\":25,\"stage_id\":\"contact\"},{\"intent\":\"include_surroundings\",\"min_silence_seconds\":8,\"prompt_template\":\"Keep some attention in the feet and let the rest open out - air, sound, light, whatever is around you.\",\"silence_after_seconds\":20,\"stage_id\":\"widen\"},{\"intent\":\"transition_out\",\"min_silence_seconds\":5,\"prompt_template\":\"Come to a stop. Stand still for a few breaths and notice how the body feels now compared with when you set off.\",\"silence_after_seconds\":10,\"stage_id\":\"close\"}],\"version\":2}",
