    "feeling_tone": {
      "canonical_json": "{\"locale\":\"en-US\",\"practice_id\":\"feeling_tone\",\"protocol_id\":\"feeling_tone_v2\",\"public_title\":\"Feeling Tone\",\"schema_version\":1,\"source\":\"authored\",\"stages\":[{\"intent\":\"establish_posture\",\"min_silence_seconds\":5,\"prompt_template\":\"Take ${duration_minutes} minutes here. Sit in a way that is alert and comfortable, and let the breath settle on its own.\",\"silence_after_seconds\":5,\"stage_id\":\"arrive\"},{\"intent\":\"recognize_pleasant_unpleasant_neutral\",\"min_silence_seconds\":8,\"prompt_template\":\"Whatever you notice, check its tone: pleasant, unpleasant or neither. One word is enough. You are naming the flavour, not the story.\",\"silence_after_seconds\":20,\"stage_id\":\"notice_tone\"},{\"intent\":\"stay_without_reacting\",\"min_silence_seconds\":10,\"prompt_template\":\"Stay one breath longer with whatever is here before moving away from it or reaching for more of it. Notice the pull itself.\",\"silence_after_seconds\":25,\"stage_id\":\"allow\"},{\"intent\":\"transition_out\",\"min_silence_seconds\":5,\"prompt_template\":\"Let the naming drop away. Sit with the whole of it for a few breaths, then finish.\",\"silence_after_seconds\":10,\"stage_id\":\"close\"}],\"version\":2}",
