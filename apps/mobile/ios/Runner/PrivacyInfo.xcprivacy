<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  App-level privacy manifest.

	  Scope: this application's own binary. The Flutter engine and each plugin
	  ship their own manifest, which Xcode aggregates into the app's privacy
	  report; duplicating their declarations here would misattribute them.

	  Every entry is derived from compliance/apple/privacy-manifest-audit.v1.yaml
	  and compliance/data-inventory.v1.yaml, and CI fails if they disagree.
	-->

	<!-- No tracking, and no data leaves the service to a third party. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<!-- The pseudonymous guest identifier. Generated on device, never
			     derived from the device, never used for tracking. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<dict>
			<!-- Self-reported check-in values, session records and feedback.
			     Declared as Other Data, not Health and Fitness: no HealthKit
			     entitlement exists and no health data is read from the device. -->
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDataTypes</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeAnalytics</string>
			</array>
		</dict>
	</array>

	<!--
	  Required Reason APIs used by this application's own code: none.

	  The app stores its identifier in Keychain, which is not a required-reason
	  API. shared_preferences, whose UserDefaults access would have needed
	  CA92.1, was removed in Program003. An empty array is the accurate answer,
	  and inventing a reason code would be worse than declaring nothing.
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
