<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer policy.

  Nothing is backed up or transferred. The only local state is the guest
  identifier in Keystore-backed storage; carrying it to another device would
  give two installs the same identity and the same server-side history, which
  is neither what the user expects nor something they could untangle.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
